/* =========================================
   MONEYMIND AI — ESTILOS COMPLETOS
   ========================================= */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  font-family: 'Inter', sans-serif;
  color: #f4f5fb;
  background: #0c0f19;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --bg: #0c0f19;
  --panel: #151a29;
  --panel-light: #1b2133;
  --border: #292f43;
  --muted: #9299b1;
  --purple: #9b87ff;
  --green: #39c6bd;
  --red: #f07878;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: var(--bg);
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  opacity: .45;
  cursor: not-allowed;
}

.app-shell {
  min-height: 100vh;
}

/* SIDEBAR */

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 255px;
  padding: 28px 19px;
  display: flex;
  flex-direction: column;
  background: #111522;
  border-right: 1px solid var(--border);
  z-index: 20;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 8px;
  margin-bottom: 52px;
}

.brand-icon {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  color: white;
  background: linear-gradient(135deg, #9b87ff, #6352cf);
  box-shadow: 0 5px 22px #8069ff44;
}

.brand strong {
  display: block;
  font-size: 17px;
  font-weight: 800;
}

.brand span {
  display: block;
  color: #858da8;
  font-size: 9px;
  letter-spacing: 2px;
  margin-top: 4px;
}

.side-label,
.eyebrow {
  color: #858da8;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.side-label {
  padding-left: 10px;
  margin-bottom: 13px;
}

.sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 13px 14px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #a0a7bd;
  text-align: left;
  font-size: 13px;
  font-weight: 600;
  transition: .2s;
}

.nav-item:hover {
  background: #20263a;
  color: white;
}

.nav-item.active {
  color: white;
  background: linear-gradient(100deg, #7563db44, #7563db12);
  box-shadow: inset 3px 0 #9b87ff;
}

.sidebar-bottom {
  margin-top: auto;
}

.side-tip {
  padding: 18px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  border: 1px solid #3b345c;
  border-radius: 14px;
  background: linear-gradient(140deg, #292347, #171b2c);
  color: #b7a9ff;
}

.side-tip strong {
  color: white;
  line-height: 1.5;
  font-size: 14px;
}

.side-tip span {
  color: #a7a1c3;
  font-size: 11px;
  line-height: 1.5;
}

.profile {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 20px 7px 0;
  margin-top: 20px;
  border-top: 1px solid var(--border);
}

.avatar {
  width: 37px;
  height: 37px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #7563db;
  font-weight: 800;
}

.profile strong,
.profile span {
  display: block;
  font-size: 12px;
}

.profile span {
  color: var(--muted);
  margin-top: 4px;
}

/* CONTENIDO PRINCIPAL */

.main-content {
  max-width: 1650px;
  min-height: 100vh;
  margin-left: 255px;
  padding: 32px 42px 55px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 32px;
}

.topbar h1 {
  margin: 7px 0 0;
  font-size: 27px;
  font-weight: 800;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 13px;
}

.date-chip {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #a8aec1;
  font-size: 12px;
  padding: 11px 14px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--panel);
}

.primary-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 9px;
  padding: 12px 17px;
  color: white;
  font-size: 12px;
  font-weight: 700;
  border: 0;
  border-radius: 10px;
  background: linear-gradient(110deg, #8d78f3, #6b59d1);
  box-shadow: 0 5px 17px #8069ff30;
  transition: .2s;
}

.primary-button:hover {
  transform: translateY(-2px);
  filter: brightness(1.12);
}

.text-button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 0;
  border: 0;
  color: #a998ff;
  background: transparent;
  font-size: 12px;
  font-weight: 700;
}

.text-button:hover {
  color: white;
}

/* BANNERS */

.welcome-banner {
  min-height: 155px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 28px 32px;
  margin-bottom: 25px;
  overflow: hidden;
  border: 1px solid #3c345e;
  border-radius: 17px;
  background:
    radial-gradient(circle at 85% 20%, #8875e844, transparent 30%),
    linear-gradient(110deg, #24203e, #171b2d);
  color: #b8aaff;
}

.welcome-banner h2 {
  color: white;
  font-size: 25px;
  margin: 10px 0 7px;
}

.welcome-banner p {
  color: #a7a9c1;
  font-size: 13px;
  margin: 0;
}

/* TARJETAS */

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 17px;
  margin-bottom: 27px;
}

.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 15px;
}

.stat-card {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.stat-icon {
  width: 39px;
  height: 39px;
  display: grid;
  place-items: center;
  border-radius: 11px;
}

.stat-icon.purple {
  color: #b6a7ff;
  background: #9b87ff20;
}

.stat-icon.green {
  color: #53d8c6;
  background: #39c6bd20;
}

.stat-icon.red {
  color: #ff9292;
  background: #f0787820;
}

.stat-card > span {
  color: #a5abc0;
  font-size: 12px;
}

.stat-card > strong {
  font-size: 23px;
  font-weight: 800;
}

.stat-card small {
  color: #7f879f;
  font-size: 10px;
}

/* INICIO */

.home-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 19px;
  margin-bottom: 32px;
}

.home-summary {
  padding: 23px;
}

.home-summary h3 {
  font-size: 17px;
  margin: 10px 0 23px;
}

.home-summary-row {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  padding: 13px 0;
  border-bottom: 1px solid #282e41;
  color: #a8aec1;
  font-size: 12px;
}

.home-summary-row strong {
  color: white;
}

.home-summary-row.total-row {
  padding-top: 19px;
  border: 0;
  color: white;
  font-weight: 700;
}

.home-muted {
  color: var(--muted);
  font-size: 13px;
}

.mini-goal {
  margin: 18px 0;
}

.mini-goal > div:first-child {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 10px;
}

.mini-goal strong {
  font-size: 12px;
}

.mini-goal span {
  color: var(--muted);
  font-size: 11px;
}

/* BARRAS DE PROGRESO */

.progress-track {
  width: 100%;
  height: 7px;
  overflow: hidden;
  border-radius: 20px;
  background: #2a3044;
}

.progress-track > div {
  height: 100%;
  border-radius: inherit;
  transition: width .3s;
}

/* SECCIONES */

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin: 29px 0 17px;
}

.section-heading h2 {
  font-size: 19px;
  margin: 7px 0 0;
}

.transaction-panel {
  padding: 8px 20px;
}

/* TRANSACCIONES */

.transaction-list {
  width: 100%;
}

.transaction-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 14px 0;
  border-bottom: 1px solid #282e41;
}

.transaction-row:last-child {
  border-bottom: 0;
}

.transaction-icon {
  width: 39px;
  height: 39px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 11px;
}

.transaction-icon.income {
  color: #4dd5bf;
  background: #39c6bd20;
}

.transaction-icon.expense {
  color: #ff9292;
  background: #f0787820;
}

.transaction-info {
  flex: 1;
  min-width: 0;
}

.transaction-info strong,
.transaction-info span {
  display: block;
}

.transaction-info strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 12px;
}

.transaction-info span {
  color: #8d95ad;
  font-size: 10px;
  margin-top: 5px;
}

.amount-positive {
  color: #51d4b9 !important;
}

.amount-negative {
  color: #ff8585 !important;
}

.delete-button {
  width: 31px;
  height: 31px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border: 0;
  border-radius: 8px;
  color: #7f879e;
  background: transparent;
}

.delete-button:hover {
  color: #ff8585;
  background: #f0787818;
}

/* DASHBOARD */

.hero-card {
  min-height: 230px;
  position: relative;
  overflow: hidden;
  padding: 30px 34px;
  margin-bottom: 24px;
  border: 1px solid #3c345e;
  border-radius: 18px;
  background: linear-gradient(115deg, #292347, #171c31 75%);
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-label {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #b8aaff;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.3px;
}

.hero-card h2,
.savings-hero h2 {
  margin: 14px 0 7px;
  font-size: 38px;
  font-weight: 800;
}

.hero-card p,
.savings-hero p {
  color: #a9acc3;
  font-size: 12px;
}

.hero-stats {
  display: flex;
  gap: 35px;
  margin-top: 25px;
}

.hero-stats span,
.hero-stats strong {
  display: flex;
  align-items: center;
  gap: 6px;
}

.hero-stats span {
  color: #a9acc3;
  font-size: 11px;
}

.hero-stats strong {
  margin-top: 6px;
  font-size: 15px;
}

.hero-orb {
  position: absolute;
  border-radius: 50%;
  background: #a18bff14;
}

.orb-one {
  width: 240px;
  height: 240px;
  right: 70px;
  top: -90px;
}

.orb-two {
  width: 170px;
  height: 170px;
  right: -25px;
  bottom: -95px;
}

.hero-decoration {
  position: absolute;
  right: 75px;
  top: 50%;
  transform: translateY(-50%);
  color: #b4a4ff30;
}

/* ESTADÍSTICAS Y GRÁFICOS */

.charts-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr;
  gap: 18px;
}

.chart-panel {
  min-width: 0;
  padding: 22px;
}

.large-chart {
  min-width: 0;
}

.full-chart {
  grid-column: 1 / -1;
}

.panel-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 18px;
}

.panel-heading h3 {
  font-size: 15px;
  margin: 0;
}

.panel-heading p {
  color: #8e96ae;
  font-size: 11px;
  margin: 6px 0 0;
}

.chart-tag {
  padding: 7px 10px;
  border-radius: 7px;
  color: #a99aff;
  background: #9b87ff18;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .7px;
  white-space: nowrap;
}

.chart-legend {
  display: flex;
  gap: 18px;
  margin-bottom: 10px;
}

.chart-legend span,
.category-legend span {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #a6adc0;
  font-size: 11px;
}

.legend-dot,
.category-legend i {
  width: 8px;
  height: 8px;
  display: inline-block;
  border-radius: 50%;
}

.income-dot {
  background: #39c6bd;
}

.expense-dot {
  background: #9b87ff;
}

.category-legend {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.category-legend > div {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.category-legend strong {
  font-size: 11px;
}

/* AHORROS */

.savings-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 29px 33px;
  margin-bottom: 23px;
  border: 1px solid #3d365f;
  border-radius: 17px;
  background: linear-gradient(110deg, #292347, #171b2c);
}

.savings-hero-icon {
  color: #b5a5ff;
  opacity: .75;
}

.goals-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.goal-card {
  padding: 22px;
}

.goal-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goal-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 13px;
}

.goal-card h3 {
  font-size: 16px;
  margin: 20px 0 15px;
}

.goal-numbers {
  display: flex;
  align-items: baseline;
  gap: 7px;
  margin-bottom: 13px;
}

.goal-numbers strong {
  font-size: 23px;
}

.goal-numbers span {
  color: var(--muted);
  font-size: 11px;
}

.goal-bottom {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  color: #939bb1;
  font-size: 10px;
  margin-top: 10px;
}

.goal-add-button {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: 21px;
  padding: 11px;
  border: 1px solid #514779;
  border-radius: 9px;
  background: #9b87ff12;
  color: #b7a8ff;
  font-size: 11px;
  font-weight: 700;
}

.goal-add-button:hover {
  background: #9b87ff25;
}

.empty-goals {
  padding: 20px;
  text-align: center;
}

.savings-tip {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  padding: 19px;
  margin-top: 22px;
  color: #b4a4ff;
  background: #9b87ff0c;
  border-color: #40375f;
}

.savings-tip strong {
  color: white;
  font-size: 13px;
}

.savings-tip p {
  color: #a5abc0;
  font-size: 11px;
  line-height: 1.6;
}

/* INVERSIONES */

.fund-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-bottom: 22px;
}

.fund-card {
  padding: 22px;
  min-width: 0;
}

.fund-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  color: #a998ff;
  background: #9b87ff20;
  margin-bottom: 16px;
}

.fund-card h3 {
  margin: 13px 0 8px;
  font-size: 15px;
}

.fund-card p {
  color: #9da3ba;
  line-height: 1.55;
  min-height: 66px;
  font-size: 12px;
}

.fund-meta {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 11px 0;
  border-top: 1px solid #ffffff12;
  font-size: 11px;
}

.fund-meta span {
  color: #9da3ba;
}

.fund-meta strong {
  text-align: right;
}

/* GASTOS MENSUALES */

.feature-panel {
  padding: 22px;
  margin: 18px 0;
}

.inline-form {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
  align-items: end;
  gap: 14px;
}

.inline-form label,
.salary-input {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #aeb3c8;
  font-size: 12px;
}

.inline-form input,
.inline-form select,
.salary-input input,
.modal-form input,
.modal-form select,
.save-prompt input,
.save-prompt select {
  width: 100%;
  min-width: 0;
  padding: 12px 13px;
  border: 1px solid #343950;
  border-radius: 10px;
  background: #111525;
  color: #f4f5fb;
  outline: none;
}

.inline-form input:focus,
.inline-form select:focus,
.salary-input input:focus,
.modal-form input:focus,
.modal-form select:focus {
  border-color: #9b87ff;
}

.bill-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto 32px;
  align-items: center;
  gap: 18px;
  padding: 14px 0;
  border-bottom: 1px solid #ffffff12;
}

.bill-row:last-child {
  border-bottom: 0;
}

.bill-row small {
  display: block;
  color: #8f96ae;
  margin-top: 4px;
  font-size: 10px;
}

.bill-check {
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
}

.bill-check input {
  width: 17px;
  height: 17px;
  accent-color: #39c6bd;
}

.bill-status {
  padding: 6px 10px;
  border-radius: 20px;
  color: #ffbd83;
  background: #ffb86b1f;
  font-size: 10px;
  white-space: nowrap;
}

.bill-status.paid {
  color: #5bd7b5;
  background: #39c6bd1f;
}

/* NÓMINA */

.salary-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 24px;
  margin: 18px 0;
}

.salary-panel h3 {
  margin: 9px 0 6px;
  font-size: 17px;
}

.salary-panel p {
  color: #9da3ba;
  font-size: 12px;
  margin: 0;
}

.salary-input {
  width: min(280px, 100%);
}

.salary-input input {
  font-size: 22px;
  font-weight: 700;
}

.ai-advice {
  display: flex;
  gap: 15px;
  align-items: flex-start;
  padding: 20px;
  margin-top: 18px;
  border: 1px solid #9b87ff40;
  border-radius: 16px;
  background: #9b87ff12;
  color: #b6a9ff;
}

.ai-advice > svg {
  flex-shrink: 0;
}

.ai-advice strong {
  color: #f4f2ff;
  font-size: 13px;
}

.ai-advice p {
  color: #b7bdd0;
  line-height: 1.6;
  margin: 7px 0;
  font-size: 12px;
}

.ai-advice small {
  color: #858da8;
  line-height: 1.5;
  font-size: 10px;
}

/* MODALES */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 18px;
  background: #050710c9;
  backdrop-filter: blur(7px);
}

.modal-card {
  width: min(100%, 440px);
  max-height: 90vh;
  overflow-y: auto;
  padding: 24px;
  border: 1px solid #383e55;
  border-radius: 17px;
  background: #171c2c;
  box-shadow: 0 20px 80px #0008;
}

.modal-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22px;
}

.modal-heading h2 {
  font-size: 18px;
  margin: 0;
}

.modal-heading button {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 8px;
  color: #aab0c3;
  background: #ffffff0b;
}

.modal-form {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.modal-form label,
.save-prompt label {
  color: #aeb4c9;
  font-size: 11px;
  font-weight: 600;
  margin-top: 6px;
}

.submit-button {
  width: 100%;
  margin-top: 12px;
}

.type-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 9px;
  margin-bottom: 8px;
}

.type-switch button {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 7px;
  padding: 11px;
  border: 1px solid #343950;
  border-radius: 9px;
  background: #111525;
  color: #aeb4c9;
  font-size: 12px;
}

.type-switch button.selected.income-selected {
  border-color: #39c6bd;
  color: #52d7c0;
  background: #39c6bd15;
}

.type-switch button.selected.expense-selected {
  border-color: #f07878;
  color: #ff9292;
  background: #f0787815;
}

.save-prompt {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.save-prompt h3 {
  font-size: 17px;
  margin: 0;
}

.save-prompt p {
  color: #a5abc0;
  font-size: 12px;
  line-height: 1.6;
  margin: 0;
}

.success-icon {
  width: 49px;
  height: 49px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: #4dd5b9;
  background: #39c6bd20;
}

.hint-text {
  color: #858da8;
  font-size: 10px;
}

.skip-button {
  padding: 11px;
  border: 0;
  color: #a5abc0;
  background: transparent;
  font-size: 11px;
}

/* ESTADOS VACÍOS */

.empty-state {
  min-height: 130px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 12px;
  color: #747d98;
  text-align: center;
}

.empty-state p {
  font-size: 12px;
}

/* ASISTENTE IA (CHAT) */

.chat-fab {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 90;
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 50%;
  color: white;
  background: linear-gradient(135deg, #9b87ff, #6352cf);
  box-shadow: 0 8px 28px #8069ff66;
  transition: .2s;
}

.chat-fab:hover {
  transform: translateY(-2px) scale(1.04);
  filter: brightness(1.1);
}

.chat-panel {
  position: fixed;
  right: 24px;
  bottom: 92px;
  z-index: 90;
  width: min(430px, calc(100vw - 32px));
  height: min(650px, calc(100vh - 120px));
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid #383e55;
  border-radius: 17px;
  background: #151a29;
  box-shadow: 0 20px 70px #000a;
}

.chat-header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 15px 16px;
  border-bottom: 1px solid var(--border);
  background: linear-gradient(110deg, #292347, #171c31);
}

.chat-header-icon {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: #b8aaff;
  background: #9b87ff25;
}

.chat-header strong,
.chat-header span {
  display: block;
}

.chat-header strong {
  font-size: 13px;
}

.chat-header span {
  margin-top: 3px;
  color: #a7a9c1;
  font-size: 10px;
}

.chat-header-actions {
  display: flex;
  gap: 7px;
  margin-left: auto;
}

.chat-header-actions button {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 8px;
  color: #aab0c3;
  background: #ffffff0b;
}

.chat-header-actions button:hover {
  color: white;
  background: #ffffff18;
}

.chat-messages {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 16px;
  overflow-y: auto;
}

.chat-bubble {
  max-width: 86%;
  padding: 10px 13px;
  border-radius: 14px;
  font-size: 12px;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.chat-bubble p {
  margin: 0 0 8px;
  white-space: pre-wrap;
}

.chat-bubble ul,
.chat-bubble ol {
  margin: 4px 0 8px;
  padding-left: 18px;
}

.chat-bubble li {
  margin: 3px 0;
}

.chat-bubble h4 {
  margin: 10px 0 6px;
  font-size: 12.5px;
  color: white;
}

.chat-bubble code {
  padding: 1px 5px;
  border-radius: 5px;
  background: #ffffff14;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
}

.chat-bubble pre {
  margin: 6px 0 8px;
  padding: 10px 12px;
  overflow-x: auto;
  border-radius: 9px;
  background: #0d1120;
}

.chat-bubble pre code {
  padding: 0;
  background: transparent;
}

.chat-bubble > :last-child {
  margin-bottom: 0;
}

.chat-bubble.assistant {
  align-self: flex-start;
  border-bottom-left-radius: 4px;
  color: #dfe2f0;
  background: #20263a;
}

.chat-bubble.user {
  align-self: flex-end;
  white-space: pre-wrap;
  border-bottom-right-radius: 4px;
  color: white;
  background: linear-gradient(110deg, #8d78f3, #6b59d1);
}

.chat-typing {
  display: inline-flex;
  gap: 5px;
  padding: 4px 0;
}

.chat-typing i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #9299b1;
  animation: chat-bounce 1.2s infinite ease-in-out;
}

.chat-typing i:nth-child(2) { animation-delay: .15s; }
.chat-typing i:nth-child(3) { animation-delay: .3s; }

@keyframes chat-bounce {
  0%, 80%, 100% { opacity: .3; transform: translateY(0); }
  40% { opacity: 1; transform: translateY(-3px); }
}

.chat-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  padding: 0 16px 12px;
}

.chat-chips button {
  padding: 7px 10px;
  border: 1px solid #514779;
  border-radius: 20px;
  color: #b7a8ff;
  background: #9b87ff12;
  font-size: 10.5px;
  font-weight: 600;
}

.chat-chips button:hover {
  background: #9b87ff25;
}

.chat-form {
  display: flex;
  gap: 9px;
  padding: 12px 14px 6px;
  border-top: 1px solid var(--border);
}

.chat-form textarea {
  flex: 1;
  min-width: 0;
  max-height: 110px;
  resize: none;
  font-family: inherit;
  line-height: 1.45;
  padding: 11px 13px;
  border: 1px solid #343950;
  border-radius: 10px;
  background: #111525;
  color: #f4f5fb;
  font-size: 12px;
  outline: none;
}

.chat-form textarea:focus {
  border-color: #9b87ff;
}

.chat-form button {
  width: 42px;
  align-self: flex-end;
  height: 42px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 10px;
  color: white;
  background: linear-gradient(110deg, #8d78f3, #6b59d1);
}

.chat-form button.chat-stop {
  color: #ff9292;
  background: #f0787830;
}

.chat-disclaimer {
  padding: 0 16px 11px;
  color: #747d98;
  font-size: 9.5px;
  text-align: center;
}

@media (max-width: 650px) {
  .chat-fab {
    right: 16px;
    bottom: 16px;
  }

  .chat-panel {
    right: 16px;
    bottom: 80px;
    height: min(520px, calc(100vh - 100px));
  }
}

/* RESPONSIVE */

@media (max-width: 1200px) {
  .main-content {
    padding: 28px 25px 45px;
  }

  .fund-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .inline-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .sidebar {
    width: 205px;
    padding: 22px 12px;
  }

  .main-content {
    margin-left: 205px;
    padding: 25px 20px;
  }

  .stat-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .charts-grid {
    grid-template-columns: 1fr;
  }

  .full-chart {
    grid-column: auto;
  }

  .home-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 650px) {
  .sidebar {
    position: relative;
    width: 100%;
    height: auto;
    padding: 13px;
    border-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .brand {
    margin-bottom: 15px;
  }

  .side-label,
  .sidebar-bottom {
    display: none;
  }

  .sidebar nav {
    flex-direction: row;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .nav-item {
    width: auto;
    flex-shrink: 0;
    padding: 10px 12px;
    font-size: 11px;
  }

  .main-content {
    margin-left: 0;
    padding: 20px 14px 35px;
  }

  .topbar {
    align-items: flex-start;
    flex-direction: column;
    margin-bottom: 22px;
  }

  .topbar h1 {
    font-size: 23px;
  }

  .top-actions {
    width: 100%;
    justify-content: space-between;
  }

  .date-chip {
    font-size: 10px;
  }

  .primary-button {
    padding: 11px 12px;
    font-size: 10px;
  }

  .welcome-banner {
    min-height: 135px;
    padding: 21px;
  }

  .welcome-banner h2 {
    font-size: 19px;
  }

  .welcome-banner p {
    font-size: 11px;
    line-height: 1.5;
  }

  .stat-grid {
    grid-template-columns: 1fr;
    gap: 11px;
  }

  .stat-card {
    padding: 16px;
  }

  .stat-card > strong {
    font-size: 21px;
  }

  .hero-card {
    padding: 23px;
  }

  .hero-card h2,
  .savings-hero h2 {
    font-size: 30px;
  }

  .hero-decoration {
    right: 20px;
    opacity: .4;
  }

  .hero-stats {
    gap: 20px;
  }

  .goals-grid,
  .fund-grid {
    grid-template-columns: 1fr;
  }

  .section-heading h2 {
    font-size: 16px;
  }

  .chart-panel,
  .feature-panel {
    padding: 16px;
  }

  .inline-form {
    grid-template-columns: 1fr;
  }

  .salary-panel {
    align-items: stretch;
    flex-direction: column;
  }

  .salary-input {
    width: 100%;
  }

  .bill-row {
    grid-template-columns: minmax(0, 1fr) auto 32px;
    gap: 10px;
  }

  .bill-status {
    grid-column: 2;
    grid-row: 2;
    justify-self: end;
  }

  .savings-hero {
    padding: 22px;
  }

  .savings-hero-icon {
    display: none;
  }

  .transaction-row {
    gap: 9px;
  }

  .transaction-info strong {
    font-size: 11px;
  }

  .transaction-row > strong {
    font-size: 11px;
  }

  .modal-card {
    padding: 19px;
  }
}